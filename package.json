{
  "name": "fleet",
  "version": "1.2.1",
  "description": "Fleet — a clean, white, minimalist multi-instance launcher for Roblox",
  "author": "Toluwa",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "node test/selftest.js",
    "make-icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "pack": "electron-builder --dir --win --x64 -c.win.signAndEditExecutable=false",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.toluwa.fleet",
    "productName": "Fleet",
    "executableName": "Fleet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "artifactName": "FleetInstaller.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Toluwer",
      "repo": "Fleet",
      "releaseType": "release"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fleet",
      "runAfterFinish": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Fleet"
    }
  }
}
