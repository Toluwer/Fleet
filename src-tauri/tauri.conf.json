{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fleet",
  "version": "1.5.0",
  "identifier": "com.toluwa.fleet",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "echo dev",
    "beforeBuildCommand": "echo build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fleet",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../src/main",
      "../node_modules/koffi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
