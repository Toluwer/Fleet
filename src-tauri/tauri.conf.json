{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "Fleet",
    "version":  "1.5.5",
    "identifier":  "com.toluwa.fleet",
    "build":  {
                  "frontendDist":  "../src/renderer",
                  "beforeDevCommand":  "echo dev",
                  "beforeBuildCommand":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-tauri-resources.ps1"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "Fleet",
                                    "width":  1120,
                                    "height":  740,
                                    "minWidth":  900,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "backgroundColor":  "#00000000",
                                    "shadow":  false,
                                    "theme":  "Dark",
                                    "fullscreen":  false,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "nsis",
                   "resources":  [
                                     "../src/main",
                                     "../node_modules/koffi",
                                     "resources/node.exe"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "embedBootstrapper",
                                                              "silent":  true
                                                          },
                                   "nsis":  {
                                                "template":  "fleet-installer.nsi",
                                                "installerIcon":  "icons/icon.ico",
                                                "uninstallerIcon":  "icons/icon.ico",
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "English"
                                                              ],
                                                "displayLanguageSelector":  false
                                            }
                               }
               }
}
